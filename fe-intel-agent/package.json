    "dependencies": {
        "axios": "^1.6.0",
        "cheerio": "^1.0.0-rc.12",
        "express": "^4.18.2",
        "node-cron": "^3.0.2",
        "openai": "^4.0.0"
    },
    "devDependencies": {
        "concurrently": "^8.2.0"
    }
}